<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>yaml-config-navigator</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>YAML Config Navigator</name>
    <description>YAML config to Python class navigation plugin for PyCharm</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!--
            PyCharm 所有 jar 的 classpath，由 build.bat 动态生成并通过 -Dpycharm.cp=... 传入。
            包含：lib/*.jar + plugins/python/lib/*.jar + plugins/yaml/lib/*.jar
        -->
        <pycharm.cp></pycharm.cp>
    </properties>

    <!--
        本项目不依赖远程 Maven 仓库的 IntelliJ Platform artifacts。
        所有 IntelliJ Platform / Python 插件 / YAML 插件的类
        都通过 maven-compiler-plugin 的 -classpath 从本地 PyCharm 安装目录引用。
        这些依赖在运行时由 PyCharm 提供（相当于 provided scope）。

        IDEA 编辑器报红解决：
        File → Project Structure → Libraries → + → Java
        依次添加以下三个目录：
        1. D:\soft\JetBrains\PyCharm 2025.1\lib
        2. D:\soft\JetBrains\PyCharm 2025.1\plugins\python\lib
        3. D:\soft\JetBrains\PyCharm 2025.1\plugins\yaml\lib
    -->
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- 无远程依赖，全部通过 -classpath 引用本地 PyCharm jar -->
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>

        <plugins>
            <!-- Java 编译插件：通过 -classpath 引用本地 PyCharm 的所有 jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>-classpath</arg>
                        <arg>${pycharm.cp}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- 打包插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>
        </plugins>
    </build>
</project>
